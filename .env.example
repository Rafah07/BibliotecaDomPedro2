# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O arquivo .env NUNCA deve ir para o Git: ele está no .gitignore.

# Ambiente: development (permite as contas demonstrativas sem banco) ou production.
APP_ENV=development

# Caminho do site no navegador. Deixe vazio para descobrir sozinho.
# Exemplos: /  (raiz do domínio)   ou   /BibliotecaDomPedro2  (subpasta no XAMPP)
APP_BASE_PATH=

# Banco MySQL 8.0+ ou MariaDB 10.4+ (charset utf8mb4).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=biblioteca_dom_pedro
DB_USER=usuario_biblioteca
DB_PASSWORD=

# Classificação CDD: e-mail de contato enviado às fontes públicas e fontes habilitadas.
CDD_CONTATO=
CDD_FONTE_LOC=true
CDD_FONTE_OPENLIBRARY=true
# WebDewey exige licença da OCLC: mantenha false até a escola ter acesso.
CDD_FONTE_WEBDEWEY=false

# Pasta privada das planilhas enviadas (padrão: storage/importacoes).
STORAGE_IMPORTACOES=

# -----------------------------------------------------------------------------
# As variáveis abaixo (domínio dos alunos, regras de empréstimo, etiquetas,
# segurança e manutenção) também podem ser alteradas no painel, em
# Sistema → Configurações. O valor salvo no painel vale mais que este arquivo;
# apagar o campo no painel volta a usar o valor daqui.
# -----------------------------------------------------------------------------

# Importação de alunos: domínio do e-mail institucional (ex.: escola.edu.br).
# Vazio aceita qualquer e-mail válido; preenchido, e-mails de outros domínios não são gravados.
ALUNOS_EMAIL_DOMINIO=

# Fuso horário da escola: datas dos empréstimos, prazos e cálculo de atrasos.
APP_TIMEZONE=America/Sao_Paulo

# Regras de empréstimo. A escola ainda não aprovou um regulamento: enquanto
# EMPRESTIMO_PRAZO_DIAS estiver vazio, o sistema usa 14 dias como valor PROVISÓRIO
# e avisa isso nas telas de empréstimo.
EMPRESTIMO_PRAZO_DIAS=
# Dias acrescentados em cada renovação (vazio: o mesmo prazo do empréstimo).
EMPRESTIMO_RENOVACAO_DIAS=
# Limite de renovações por empréstimo (vazio: sem limite da escola; o banco aceita até 10).
EMPRESTIMO_MAX_RENOVACOES=
# Permite renovar empréstimo atrasado (true/false; vazio: true).
EMPRESTIMO_RENOVAR_ATRASADO=
# Maior prazo aceito quando a bibliotecária escolhe a data manualmente (vazio: 365 dias).
EMPRESTIMO_PRAZO_MAXIMO_DIAS=
# Máximo de livros emprestados ao mesmo tempo por aluno (vazio: sem limite).
EMPRESTIMO_LIMITE_ALUNO=
# Impede novo empréstimo para aluno com livro atrasado (true/false; vazio: false).
EMPRESTIMO_BLOQUEAR_ATRASO=

# Nome impresso nas etiquetas dos exemplares (vazio: Biblioteca Dom Pedro II).
# Não coloque dados pessoais, senhas ou tokens aqui: o texto vai para as etiquetas.
ETIQUETA_BIBLIOTECA=

# Segurança do painel: minutos sem uso até a sessão terminar (vazio: 120) e
# tentativas de senha antes do bloqueio de 15 minutos (vazio: 5).
PAINEL_INATIVIDADE_MINUTOS=
LOGIN_MAX_TENTATIVAS=

# Site público em manutenção (true/false; vazio: false). O painel não é afetado.
SITE_MANUTENCAO=
SITE_MANUTENCAO_MENSAGEM=
