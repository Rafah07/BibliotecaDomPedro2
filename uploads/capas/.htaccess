# Capas dos livros: só imagens podem ser abertas; nenhum script é executado nesta pasta.
Options -Indexes
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .asp .aspx .sh .shtml
RemoveType .php .phtml .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|asp|aspx|sh|shtml|html?|svg|js)$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
